// EnvVault data model.
//
// Security invariant: this schema stores ONLY encrypted blobs and wrapped
// keys (ciphertext) plus non-secret metadata. Every column that looks like
// key material (wrapped*Key*, *Iv, *Ciphertext) is opaque to the server —
// it is produced and consumed exclusively by client-side code in
// packages/crypto. Nothing here allows the API to recover plaintext.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection string (e.g. a Neon/Supabase PgBouncer endpoint) —
  // required on serverless deployments (Vercel) where each invocation can
  // open a fresh connection. directUrl is optional: only used by
  // `prisma migrate`, which needs an unpooled connection. Non-serverless
  // deployments can safely point both at the same plain connection string.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String // argon2id hash of the ACCOUNT login password (auth only, not key material)
  name         String?

  // Vault key material: wraps the user's master key under a KEK derived
  // client-side from the user's vault passphrase. Opaque to the server.
  kdfSalt                     String
  kdfIterations                Int
  wrappedMasterKeyIv           String
  wrappedMasterKeyCiphertext   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  projects            Project[]
  deviceAuthRequests  DeviceAuthRequest[]
  auditLogs           AuditLog[]

  @@map("users")
}

enum ClientType {
  WEB
  CLI
}

/// An authenticated device/browser — the unit of session revocation.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String     @unique // sha256(refresh token) — the raw token is never stored
  clientType       ClientType
  deviceName       String? // e.g. hostname for CLI, browser/OS for web
  userAgent        String?
  ipAddress        String?

  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  createdVersions FileVersion[]

  @@index([userId])
  @@map("sessions")
}

enum DeviceAuthStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CONSUMED
}

/// CLI device authorization flow (RFC 8628-style): the CLI polls with
/// `deviceCode` while the user approves `userCode` in the browser. No
/// account password ever touches the CLI process.
model DeviceAuthRequest {
  id         String           @id @default(cuid())
  deviceCode String           @unique
  userCode   String           @unique
  status     DeviceAuthStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  deviceName String? // hostname supplied by the CLI, shown to the user before they approve

  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastPolledAt DateTime?

  @@map("device_auth_requests")
}

model Project {
  // Client-generated UUID (see CreateProjectRequestSchema in
  // @envvault/types): the project key must be wrapped with this id bound
  // as AAD before the row exists, so the client originates the id rather
  // than the server assigning one on insert.
  id      String @id
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name String

  // Normalized git remote ("github.com/org/repo") used for `envvault init`
  // auto-detection. Optional — git is never required.
  gitRemoteUrl String?

  // The project's data-encryption key, wrapped under the owner's master key.
  wrappedProjectKeyIv         String
  wrappedProjectKeyCiphertext String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files ProjectFile[]

  @@unique([ownerId, name])
  @@index([ownerId, gitRemoteUrl])
  @@map("projects")
}

model ProjectFile {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  filename String // validated server-side against a strict allowlist pattern

  currentVersionId String?      @unique
  currentVersion   FileVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions FileVersion[] @relation("FileVersions")

  @@unique([projectId, filename])
  @@map("project_files")
}

model FileVersion {
  id     String      @id @default(cuid())
  fileId String
  file   ProjectFile @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)

  versionNumber Int

  // Encrypted blob location (object storage key) + AEAD parameters.
  // storageKey is generated server-side from opaque ids only — it is never
  // derived from the user-supplied filename, so it cannot path-traverse.
  storageKey String
  ivBase64   String
  // Client-chosen AAD tag bound into the AEAD encryption of this version's
  // content (see UploadFileVersionRequestSchema) — opaque to the server.
  contentId  String

  plaintextSize   Int
  plaintextSha256 String // integrity/dedup metadata only — never used as key material

  createdAt DateTime @default(now())

  createdBySessionId String?
  createdBySession   Session? @relation(fields: [createdBySessionId], references: [id], onDelete: SetNull)

  currentOfFile ProjectFile? @relation("CurrentVersion")

  @@unique([fileId, versionNumber])
  @@map("file_versions")
}

/// Opaque encrypted file bytes stored in Postgres. This is the simplest
/// serverless-friendly storage option for free-tier Vercel deployments with
/// small env/config files; S3-compatible storage remains available for larger
/// production vaults.
model StorageObject {
  key  String @id
  data Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("storage_objects")
}

/// Security-sensitive action log. Never stores secret contents — only
/// action metadata (who, what kind of object, when, from where).
model AuditLog {
  id     String @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}
