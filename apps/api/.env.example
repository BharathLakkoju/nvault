# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string (used by the app at runtime — on serverless
# platforms this should be your provider's *pooled* connection string, e.g.
# Neon/Supabase's PgBouncer endpoint).
DATABASE_URL="postgresql://envvault:envvault@localhost:5432/envvault?schema=public"

# Unpooled connection string, used only by `prisma migrate`. On a plain
# Postgres instance (Docker, a VPS) this is identical to DATABASE_URL. On a
# pooled provider, use the *direct* (non-PgBouncer) connection string here.
DIRECT_DATABASE_URL="postgresql://envvault:envvault@localhost:5432/envvault?schema=public"

# Origin of the web app, for CORS + device-flow verification links.
WEB_ORIGIN="http://localhost:3000"

# Port the API listens on.
PORT=4000

# JWT signing secret for short-lived access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-random-48-byte-base64-string"
JWT_ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000       # 30 days
DEVICE_AUTH_TTL_SECONDS=600             # 10 minutes
DEVICE_AUTH_POLL_INTERVAL_SECONDS=5

# Storage backend: "local" (default, no external deps) or "s3".
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./data/blobs"

# Only used when STORAGE_PROVIDER=s3 (also works with R2/MinIO via STORAGE_S3_ENDPOINT).
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_FORCE_PATH_STYLE="true"
