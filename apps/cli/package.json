{
  "name": "@envvault/cli",
  "version": "0.1.0",
  "description": "envvault — terminal CLI for the EnvVault developer environment vault. Your development environment, available anywhere.",
  "type": "commonjs",
  "license": "MIT",
  "author": "EnvVault",
  "homepage": "https://github.com/BharathLakkoju/nvault#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/BharathLakkoju/nvault.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/BharathLakkoju/nvault/issues",
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "environment-variables",
    "vault",
    "cli",
    "encryption",
    "zero-knowledge"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "envvault": "./bin/envvault.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node esbuild.config.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "prepublishOnly": "pnpm run build",
    "build:binaries": "pnpm run build && node build-binaries.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@envvault/crypto": "workspace:*",
    "@envvault/types": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.9",
    "@yao-pkg/pkg": "^5.16.1",
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
