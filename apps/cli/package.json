{
  "name": "@envvault/cli",
  "version": "0.1.0",
  "private": true,
  "description": "envvault — terminal CLI for the EnvVault developer environment vault",
  "type": "commonjs",
  "bin": {
    "envvault": "./bin/envvault.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@envvault/crypto": "workspace:*",
    "@envvault/types": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
