{
  "name": "nvault-app",
  "version": "1.0.0",
  "private": true,
  "description": "nvault — a secure, zero-knowledge developer environment/configuration vault. Single Next.js app, deployable to Vercel. (The published npm CLI is the `nvault` package in cli/.)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:cli:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects cli-integration --runInBand",
    "seed:scenarios": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.seed.config.cjs --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev && prisma generate",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@polar-sh/sdk": "^0.49.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "standardwebhooks": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.0",
    "postcss": "^8.5.26",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
