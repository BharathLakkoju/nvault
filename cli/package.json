{
  "name": "envvault-cli",
  "version": "0.1.0",
  "description": "Terminal CLI for EnvVault — a secure, zero-knowledge developer environment/configuration vault. Your development environment, available anywhere.",
  "type": "commonjs",
  "license": "MIT",
  "author": "EnvVault",
  "homepage": "https://github.com/BharathLakkoju/nvault/tree/master/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BharathLakkoju/nvault.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/BharathLakkoju/nvault/issues",
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "environment-variables",
    "vault",
    "cli",
    "encryption",
    "zero-knowledge"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "envvault": "./bin/envvault.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "node esbuild.config.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.9",
    "commander": "^12.1.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
