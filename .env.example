# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database (Postgres) ---------------------------------------------------
# DATABASE_URL: pooled connection string used by the app at runtime. On
# Vercel this MUST be your provider's pooled endpoint (Neon / Supabase
# PgBouncer) — serverless concurrency will exhaust an unpooled connection.
DATABASE_URL="postgresql://envvault:envvault@localhost:5432/envvault?schema=public"

# DIRECT_DATABASE_URL: unpooled connection string, used only by
# `prisma migrate`. On a plain local Postgres, set it equal to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://envvault:envvault@localhost:5432/envvault?schema=public"

# --- Auth ----------------------------------------------------------------
# Signing secret for short-lived access tokens (>= 32 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-random-48-byte-base64-string"
JWT_ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000       # 30 days

# --- Storage encryption ------------------------------------------------------
# Server-side key that wraps every stored file blob a SECOND time (on top of
# the client's zero-knowledge encryption) before it is written to Postgres.
# Exactly 32 bytes, base64-encoded. Generate:
#   openssl rand -base64 32
# Rotating this value makes existing stored blobs unreadable — treat it as a
# permanent secret and set it once, per environment.
STORAGE_ENCRYPTION_KEY="change-me-openssl-rand-base64-32"

# --- Marketing site --------------------------------------------------------
# Production origin of the public site, used for canonical URLs, Open Graph
# tags, sitemap.xml and robots.txt. Scheme required, no trailing slash.
# Safe to expose (NEXT_PUBLIC_*). Defaults to https://nvault.dev if unset.
NEXT_PUBLIC_SITE_URL="https://nvault.dev"

# Origin of the app itself, used to build Polar checkout success/return URLs.
# Falls back to NEXT_PUBLIC_SITE_URL, then http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Billing (Polar) ------------------------------------------------------
# Paid plans via Polar (https://polar.sh) as Merchant of Record:
#   - Pro  — per-user subscription; lifts the personal-project cap.
#   - Team — per-organization subscription in one of three flat size tiers.
# Leave these UNSET in local dev — the app then skips the paywall and
# activates new orgs immediately. They are REQUIRED in production (env.ts
# fails the build otherwise). No card data ever touches nvault: checkout and
# card management happen on Polar-hosted pages.
#
#   1. Create FOUR recurring monthly products in the Polar dashboard:
#      "nvault Pro" ($10), "nvault Team Starter" ($29), "nvault Team Growth"
#      ($79), "nvault Team Scale" ($199). Copy each product id below.
#   2. Create an Organization Access Token (scopes: checkouts:write,
#      customer_sessions:write, subscriptions:read, subscriptions:write,
#      products:read).
#   3. Add a webhook endpoint -> https://<your-app>/api/v1/webhooks/polar
#      subscribed to all subscription.* events. Copy its signing secret.
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRO_PRODUCT_ID=""
POLAR_TEAM_STARTER_PRODUCT_ID=""
POLAR_TEAM_GROWTH_PRODUCT_ID=""
POLAR_TEAM_SCALE_PRODUCT_ID=""
# "sandbox" for the Polar test environment, "production" for live.
POLAR_SERVER="sandbox"
# Display-only prices shown in the upgrade UI (real amounts are on Polar).
PRO_PLAN_PRICE_LABEL="$10 / month"
TEAM_STARTER_PRICE_LABEL="$29 / month"
TEAM_GROWTH_PRICE_LABEL="$79 / month"
TEAM_SCALE_PRICE_LABEL="$199 / month"

# Shared secret for the daily cron that purges abandoned unpaid orgs
# (>7 days in PENDING_PAYMENT). Vercel Cron sends it as a Bearer token; see
# vercel.json. Generate: openssl rand -hex 24
CRON_SECRET=""
