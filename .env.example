# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database (Postgres) ---------------------------------------------------
# DATABASE_URL: pooled connection string used by the app at runtime. On
# Vercel this MUST be your provider's pooled endpoint (Neon / Supabase
# PgBouncer) — serverless concurrency will exhaust an unpooled connection.
DATABASE_URL="postgresql://envvault:envvault@localhost:5432/envvault?schema=public"

# DIRECT_DATABASE_URL: unpooled connection string, used only by
# `prisma migrate`. On a plain local Postgres, set it equal to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://envvault:envvault@localhost:5432/envvault?schema=public"

# --- Auth ----------------------------------------------------------------
# Signing secret for short-lived access tokens (>= 32 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-random-48-byte-base64-string"
JWT_ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000       # 30 days

# --- Storage encryption ------------------------------------------------------
# Server-side key that wraps every stored file blob a SECOND time (on top of
# the client's zero-knowledge encryption) before it is written to Postgres.
# Exactly 32 bytes, base64-encoded. Generate:
#   openssl rand -base64 32
# Rotating this value makes existing stored blobs unreadable — treat it as a
# permanent secret and set it once, per environment.
STORAGE_ENCRYPTION_KEY="change-me-openssl-rand-base64-32"
