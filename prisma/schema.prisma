// EnvVault data model.
//
// Security invariant: this schema stores ONLY encrypted blobs and wrapped
// keys (ciphertext) plus non-secret metadata. Every column that looks like
// key material (wrapped*Key*, *Iv, *Ciphertext) is opaque to the server —
// it is produced and consumed exclusively by client-side code in
// src/lib/crypto. Nothing here allows the API to recover plaintext.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Prisma 7 emits ESM by default; this app's server code is CJS-interop'd
  // by Next, and Jest runs it through ts-jest as CJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 no longer reads connection URLs from the schema. The runtime
  // connection (pooled DATABASE_URL) is supplied by the driver adapter in
  // src/server/db.ts; `prisma migrate` reads the unpooled DIRECT_DATABASE_URL
  // from prisma.config.ts.
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String // argon2id hash of the ACCOUNT login password (auth only, not key material)
  name         String?

  // Vault key material: wraps the user's master key under a KEK derived
  // client-side from the user's vault passphrase. Opaque to the server.
  kdfSalt                    String
  kdfIterations              Int
  wrappedMasterKeyIv         String
  wrappedMasterKeyCiphertext String

  // Per-user asymmetric keypair (RSA-OAEP-3072, see src/lib/crypto/asymmetric.ts).
  // `publicKey` is cleartext SPKI (base64); anyone may wrap an Organization Key
  // to it. The private key is persisted ONLY wrapped under the master key
  // (AAD "user-privkey") — opaque to the server, recoverable only by a client
  // that has unlocked the vault. Nullable until provisioned (backfilled on the
  // user's next vault unlock); a user without a keypair cannot join an org.
  publicKey                   String?
  wrappedPrivateKeyIv         String?
  wrappedPrivateKeyCiphertext String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  projects           Project[]
  auditLogs          AuditLog[]
  orgMemberships     OrganizationMembership[]
  membershipsInvited OrganizationMembership[] @relation("MembershipInvitedBy")
  invitesSent        OrganizationInvite[]     @relation("InviteInvitedBy")
  keyEpochsRotated   OrganizationKeyEpoch[]   @relation("KeyEpochRotatedBy")
  subscriptionsOwned Subscription[]           @relation("SubscriptionOwner")

  @@map("users")
}

/// An authenticated browser session — the unit of session revocation.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String  @unique // sha256(refresh token) — the raw token is never stored
  userAgent        String?
  ipAddress        String?

  // Set ONLY for CLI Personal Access Tokens, never for browser sessions.
  // A PAT is a long-lived session whose bearer credential is an opaque
  // "evk_" token (only its sha256 is stored). `apiTokenName` is a
  // user-supplied label; `apiTokenPrefix` is the first few characters of the
  // raw token, kept for display only. Browser sessions leave all three null
  // and are excluded from the CLI-token views (and vice-versa).
  apiTokenHash   String? @unique
  apiTokenPrefix String?
  apiTokenName   String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  createdVersions FileVersion[]

  @@index([userId])
  @@map("sessions")
}

model Project {
  // Client-generated UUID (see CreateProjectRequestSchema in src/lib/schemas):
  // the project key must be wrapped with this id bound as AAD before the row
  // exists, so the client originates the id rather than the server assigning
  // one on insert.
  id      String @id
  // The user who created the project. For personal projects this is also the
  // sole authorized user. For org projects it is retained for attribution;
  // authorization is derived from org membership, not from ownerId.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Set iff this is an organization-scoped project. When set, the project key
  // is wrapped under the Organization Key (not a user master key) and every
  // active member of the org can decrypt it.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  // Normalized git remote ("github.com/org/repo") for project auto-detection.
  // Optional — git is never required.
  gitRemoteUrl String?

  // The project's data-encryption key. Wrapped under the owner's master key
  // for personal projects, or under the Organization Key (at `keyEpoch`) for
  // org projects. Opaque ciphertext either way.
  wrappedProjectKeyIv         String
  wrappedProjectKeyCiphertext String
  // Org Key epoch this wrapped key belongs to. 0 for personal projects and
  // for org projects created before the first key rotation.
  keyEpoch                    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files ProjectFile[]

  // Uniqueness is enforced by two partial unique indexes added in the
  // migration (Prisma cannot express `WHERE` on a unique constraint):
  //   (owner_id, name)        WHERE organization_id IS NULL
  //   (organization_id, name) WHERE organization_id IS NOT NULL
  @@index([ownerId, gitRemoteUrl])
  @@index([organizationId])
  @@map("projects")
}

model ProjectFile {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  filename String // validated server-side against a strict allowlist pattern

  currentVersionId String?      @unique
  currentVersion   FileVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  // Lifetime count of versions ever appended to this file. Monotonic: it is
  // never decremented, so deleting an old version does not let a free account
  // upload another one. Drives FREE_LIMITS.maxVersionsPerFile.
  versionsCreated Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions FileVersion[] @relation("FileVersions")

  @@unique([projectId, filename])
  @@map("project_files")
}

model FileVersion {
  id     String      @id @default(cuid())
  fileId String
  file   ProjectFile @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)

  versionNumber Int

  // Encrypted blob location (storage key) + AEAD parameters. storageKey is
  // generated server-side from opaque ids only — never from the user-supplied
  // filename, so it cannot path-traverse.
  storageKey String
  ivBase64   String
  // Client-chosen AAD tag bound into the AEAD encryption of this version's
  // content (see UploadFileVersionRequestSchema) — opaque to the server.
  contentId  String

  plaintextSize   Int
  plaintextSha256 String // integrity/dedup metadata only — never used as key material

  createdAt DateTime @default(now())

  createdBySessionId String?
  createdBySession   Session? @relation(fields: [createdBySessionId], references: [id], onDelete: SetNull)

  currentOfFile ProjectFile? @relation("CurrentVersion")

  @@unique([fileId, versionNumber])
  @@map("file_versions")
}

/// Encrypted file bytes, stored in Postgres (the only storage backend).
/// `data` is doubly encrypted: the client's AES-256-GCM ciphertext, then
/// wrapped again server-side under STORAGE_ENCRYPTION_KEY (see
/// src/server/storage.ts) with a 1-byte format-version prefix. A raw
/// database dump therefore reveals nothing without the Vercel-held key, and
/// even with it only yields the client ciphertext (still needs the user's
/// vault passphrase).
model StorageObject {
  key  String @id
  data Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("storage_objects")
}

/// Fixed-window rate-limit counters. Keyed by "<route>:<ip>" and a truncated
/// window start, so the limit holds across all concurrent serverless
/// instances without an external store. Old rows are pruned opportunistically.
model RateLimitHit {
  bucket      String
  windowStart DateTime
  count       Int      @default(1)

  @@id([bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}

/// Security-sensitive action log. Never stores secret contents — only
/// action metadata (who, what kind of object, when, from where).
model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Set for organization-scoped actions, so an org's admins can review all
  // activity in the org (not just their own). Kept (SetNull) if the org is
  // later deleted.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Organizations / teams
// ---------------------------------------------------------------------------

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgMembershipStatus {
  INVITED // invite accepted, account linked, but the Org Key has not been granted yet
  ACTIVE // holds the wrapped Org Key — full access to org projects
}

/// Billing lifecycle of an organization. An org is unusable until a Team
/// subscription is paid (`PENDING_PAYMENT`), fully usable while paid
/// (`ACTIVE`), and read-only when the subscription lapses (`SUSPENDED`).
/// See src/server/billing and src/server/authz/org-access.ts.
enum OrgStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
}

/// Our local mirror of the Polar subscription state. Kept deliberately
/// coarse — the fine-grained Polar statuses (incomplete, unpaid, paused, …)
/// all collapse into one of these four.
enum SubscriptionStatus {
  PENDING // checkout created, not yet paid
  ACTIVE // paid and current (or in a still-valid cancel-at-period-end window)
  PAST_DUE // payment failed; Polar is retrying
  CANCELED // ended — no further access
}

/// Which paid plan a subscription is for.
///   PRO  — a single user; raises their personal-project cap. No org.
///   TEAM — a single organization; unlocks org creation + shared projects.
enum SubscriptionPlan {
  PRO
  TEAM
}

/// Flat Team size tiers. Each maps to its own Polar product; the tier caps
/// how many members an organization may have (see
/// src/server/billing/entitlements.ts).
///   STARTER — up to 10 members
///   GROWTH  — up to 25 members
///   SCALE   — up to 100 members
enum SubscriptionTier {
  STARTER
  GROWTH
  SCALE
}

/// A team that owns projects shared across its members. The org row holds NO
/// key material: the Organization Key exists only as ciphertext, wrapped once
/// per member to that member's public key (OrganizationMembership).
model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Monotonic Org Key epoch. Bumped on every key rotation (member removal).
  /// Members / projects carry the epoch their wrapped key belongs to; a
  /// mismatch means "re-fetch, your key is stale".
  currentKeyEpoch Int @default(0)

  /// Organization Enrollment Secret (OES) layer. The Org Key wrapped under a
  /// KEK derived (PBKDF2) from a 128-bit secret generated in the creator's
  /// browser and shared with each invitee OUT-OF-BAND. This is how a new
  /// member obtains the Org Key — the server never sees the secret and is not
  /// in the key-delivery path, so it cannot add itself as a reader. All four
  /// fields are opaque ciphertext / KDF parameters. Regenerated on every
  /// rotation; `enrollmentKeyEpoch` is the Org Key epoch this blob wraps.
  /// See src/lib/crypto/org-enrollment.ts.
  enrollmentKdfSalt                 String
  enrollmentKdfIterations           Int
  enrollmentWrappedOrgKeyIv         String
  enrollmentWrappedOrgKeyCiphertext String
  enrollmentKeyEpoch                Int    @default(0)

  /// Encrypted member roster: {membershipId -> {userId, pubkey fingerprint}},
  /// AES-256-GCM under the Org Key (AAD "org-roster:<id>"). Each member writes
  /// their own entry (fingerprint of their local public key) as they enroll;
  /// key rotation checks every server-supplied member public key against it to
  /// detect substitution. `rosterVersion` is a monotonic optimistic-concurrency
  /// guard enforced on write. Opaque to the server (it holds no Org Key).
  /// See src/lib/crypto/org-roster.ts.
  rosterIv         String
  rosterCiphertext String
  rosterVersion    Int    @default(0)

  /// Billing gate. New orgs start `PENDING_PAYMENT` and are unusable until
  /// the Polar `subscription.active` webhook flips them to `ACTIVE`. A
  /// lapsed subscription drops them to `SUSPENDED` (read-only).
  status OrgStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?
  memberships  OrganizationMembership[]
  invites      OrganizationInvite[]
  keyEpochs    OrganizationKeyEpoch[]
  projects     Project[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   OrgRole
  status OrgMembershipStatus @default(INVITED)

  /// The Organization Key, RSA-wrapped to THIS member's public key. Null
  /// until the member enrolls with the Enrollment Secret (at which point
  /// `status` flips to ACTIVE). The member's own client produces it — from
  /// the Org Key it recovered via the OES, re-wrapped to its own public key.
  /// Opaque ciphertext — the server can neither produce nor read it.
  wrappedOrgKeyCiphertext String?
  /// The Org Key epoch `wrappedOrgKeyCiphertext` belongs to.
  keyEpoch                Int?

  /// The member's own public key (SPKI base64) as recorded by THEIR client at
  /// enrollment — the pin that key rotation checks the server-supplied key
  /// against. Null until enrolled. Distinct from `user.publicKey` (the
  /// account-level copy the server serves): a divergence is the signal that
  /// the server may have swapped it.
  pinnedPublicKey String?

  invitedById String?
  invitedBy   User?   @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  keyGrantedAt DateTime?

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

/// A pending invitation. The raw token (`oiv_…`) is shown once to the
/// inviting admin and shared out-of-band; only its sha256 is stored.
model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Lowercased. The accepting account's email must match this exactly.
  email String
  role  OrgRole

  tokenHash   String @unique
  tokenPrefix String

  invitedById String?
  invitedBy   User?   @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

/// One row per Org Key generation. History for audit + lets a client tell
/// whether the key it holds is current.
model OrganizationKeyEpoch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  epoch     Int
  createdAt DateTime @default(now())

  rotatedById String?
  rotatedBy   User?   @relation("KeyEpochRotatedBy", fields: [rotatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, epoch])
  @@map("organization_key_epochs")
}

// ---------------------------------------------------------------------------
// Billing (Polar)
// ---------------------------------------------------------------------------

/// Our local projection of one Polar subscription. Polar is the source of
/// truth; the `subscription.*` webhooks (src/app/api/v1/webhooks/polar) keep
/// this in sync. No card data is ever stored here — checkout and card
/// management happen entirely on Polar-hosted pages.
///
/// A subscription belongs to EITHER an organization (`plan = TEAM`,
/// `organizationId` set) OR a single user (`plan = PRO`, `organizationId`
/// null). `ownerUserId` is always the human who pays and owns the Polar
/// customer record — for TEAM they're also the org's billing manager.
model Subscription {
  id   String           @id @default(cuid())
  plan SubscriptionPlan @default(TEAM)

  /// Size tier — set for TEAM subscriptions only, null for PRO. Derived from
  /// the Polar product the subscription is on; kept in sync by the webhook.
  tier SubscriptionTier?

  /// Set for TEAM subscriptions only. Null for PRO.
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The user who pays and owns the Polar customer record. For TEAM, the
  /// only member who can open the billing portal. A user has at most one PRO
  /// subscription row (partial unique index in the migration).
  ownerUserId String
  ownerUser   User   @relation("SubscriptionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  status SubscriptionStatus @default(PENDING)

  /// Polar identifiers. Null until the first webhook lands (or forever, for
  /// the grandfathered rows backfilled for pre-billing organizations).
  polarCustomerId     String?
  polarSubscriptionId String? @unique
  polarProductId      String?

  /// End of the paid period. While `cancelAtPeriodEnd` is true the org stays
  /// ACTIVE until this instant, then the webhook drops it to SUSPENDED.
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A partial unique index `(ownerUserId) WHERE plan = 'PRO'` is added in the
  // migration (Prisma can't express the WHERE) — one PRO subscription per user.
  @@index([ownerUserId])
  @@map("subscriptions")
}

/// Idempotency ledger for inbound Polar webhooks, keyed by the Standard
/// Webhooks `webhook-id` header. A redelivered event whose id is already
/// here is acknowledged and skipped. Pruned opportunistically.
model ProcessedWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("processed_webhook_events")
}
