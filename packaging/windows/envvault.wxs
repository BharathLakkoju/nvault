<?xml version="1.0" encoding="UTF-8"?>
<!--
  Best-effort MSI packaging for the envvault CLI, built with the WiX v4/v5
  toolset (`dotnet tool install -g wix`).

  STATUS: written but NOT verified end-to-end — this repository was built
  in a Linux sandbox with no Windows machine or WiX toolchain available to
  actually run `wix build` against. It's wired into
  .github/workflows/cli-release.yml as a best-effort, continue-on-error job
  that only runs on a real windows-latest GitHub Actions runner. Treat the
  first real release as the first real test of this file; the tested,
  always-available Windows artifact is the plain envvault-win-x64.exe
  (from `pkg`) attached to every release — no installer required, just run it.

  This installs the single envvault.exe into
  %LocalAppData%\Programs\envvault and adds that directory to the current
  user's PATH — a per-user install, so it doesn't require admin rights.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="envvault"
    Manufacturer="EnvVault"
    Version="$(var.Version)"
    UpgradeCode="6f2d9c6a-6b1e-4b9a-9a7e-1a1a2a3a4a5a"
    Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of envvault is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Programs">
        <Directory Id="EnvVaultFolder" Name="envvault">
          <Component Id="EnvVaultExeComponent" Guid="9b1c2b3a-4d5e-4f6a-8b9c-0d1e2f3a4b5c">
            <File Id="EnvVaultExe" Source="$(var.ExePath)" KeyPath="yes" />
            <Environment
              Id="EnvVaultPath"
              Name="PATH"
              Value="[EnvVaultFolder]"
              Permanent="no"
              Part="last"
              Action="set"
              System="no" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="envvault CLI" Level="1">
      <ComponentRef Id="EnvVaultExeComponent" />
    </Feature>
  </Package>
</Wix>
